/* Généré à partir de tokens.py — ne pas mettre de couleur en dur ici. */
* {
    font-family: "Segoe UI", "Inter", sans-serif;
    font-size: 10pt;
    color: $text;
    outline: none;
}
QMainWindow, QDialog { background: $bg; }
QWidget#documentArea, QStackedWidget#toolStack { background: $surface; }

QMenuBar { background: $surface; border-bottom: 1px solid $border; }
QMenuBar::item { padding: 4px 10px; background: transparent; }
QMenuBar::item:selected { background: $surface_alt; border-radius: 4px; }
QMenu { background: $surface; border: 1px solid $border; padding: 4px; }
QMenu::item { padding: 5px 24px 5px 12px; border-radius: 4px; }
QMenu::item:selected { background: $selection; }
QMenu::separator { height: 1px; background: $border; margin: 4px 6px; }

QToolBar#mainToolbar { background: $surface; border: none; border-bottom: 1px solid $border; spacing: 4px; padding: 4px 8px; }
QToolBar#mainToolbar QToolButton { padding: 4px 10px; border-radius: 5px; }
QToolBar#mainToolbar QToolButton:hover { background: $surface_alt; }

/* Barre d'activité */
QWidget#activityBar { background: $surface_alt; border-right: 1px solid $border; }
QWidget#activityBar QToolButton { border: none; border-left: 3px solid transparent; border-radius: 0; padding: 6px 2px 4px 2px; font-size: 7pt; font-weight: 600; color: $text_muted; }
QWidget#activityBar QToolButton:hover { background: $border; }
QWidget#activityBar QToolButton:checked { border-left: 3px solid $accent; background: $surface; color: $text; }
QFrame#activitySep { background: $border; border: none; }
QWidget#activityBar QToolButton:disabled { background: transparent; }

/* Onglets de documents */
QTabWidget::pane { border: none; background: $surface; }
QTabBar { background: $surface_alt; }
QTabBar::tab { background: $surface_alt; color: $text_muted; padding: 7px 14px; border-right: 1px solid $border; }
QTabBar::tab:selected { background: $surface; color: $text; border-top: 2px solid $accent; }
QTabBar::tab:hover:!selected { background: $border; }
QTabBar::close-button { image: url("$close_icon"); subcontrol-position: right; width: 14px; height: 14px;
                        border-radius: 3px; margin-left: 6px; }
QTabBar::close-button:hover { background: $border; }

QSplitter::handle { background: $border; }
QSplitter::handle:horizontal { width: 1px; }
QSplitter::handle:vertical { height: 1px; }

/* Panneau Problèmes */
QDockWidget { titlebar-close-icon: none; }
QDockWidget::title { background: $surface_alt; padding: 5px 10px; border-top: 1px solid $border; }
QWidget#problemsHeader { background: $surface; border-bottom: 1px solid $border; }
QTableView { background: $surface; alternate-background-color: $bg; gridline-color: transparent;
             selection-background-color: $selection; selection-color: $text; border: none; }
QHeaderView::section { background: $surface_alt; color: $text_muted; padding: 4px 6px; border: none;
                       border-right: 1px solid $border; border-bottom: 1px solid $border; }
QTextBrowser#findingDetail { background: $bg; border: none; border-left: 1px solid $border; padding: 8px; }

QToolButton#severityFilter { border: 1px solid $border; border-radius: 10px; padding: 2px 10px; background: $surface; }
QToolButton#severityFilter:checked { background: $selection; }

/* Vue XML */
QWidget#xmlToolbar { background: $surface; border-bottom: 1px solid $border; }
QWidget#xmlToolbar QLineEdit { padding: 3px 6px; }
QToolButton#xmlTool { border: none; border-radius: 4px; padding: 3px; }
QToolButton#xmlTool:hover { background: $surface_alt; }
QToolButton#xmlTool:checked { background: $selection; }
QFrame#xmlToolbarSep { background: $border; }
QLabel#xmlFindCount { color: $text_muted; padding: 0 6px; }
QLabel#xmlFindCount[empty="true"] { color: $error; }
QLabel#xmlNote { color: $text_muted; font-style: italic; padding: 0 4px; }
QScrollArea#xmlBreadcrumb { background: $surface_alt; border: none; border-bottom: 1px solid $border; }
QWidget#xmlBreadcrumbInner { background: $surface_alt; }
QToolButton#crumb { border: none; border-radius: 3px; padding: 1px 5px; color: $text_muted; }
QToolButton#crumb:hover { background: $selection; color: $text; }
QToolButton#crumb[current="true"] { color: $text; font-weight: 600; }
QLabel#crumbSep { color: $text_muted; padding: 0 1px; }

QLineEdit, QComboBox { background: $surface; border: 1px solid $border; border-radius: 5px; padding: 4px 8px;
                       selection-background-color: $selection; selection-color: $text; }
QLineEdit:focus, QComboBox:focus { border-color: $accent; }
QComboBox QAbstractItemView { background: $surface; border: 1px solid $border; selection-background-color: $selection; }

QPushButton { background: $surface; border: 1px solid $border; border-radius: 5px; padding: 6px 14px; }
QPushButton:hover { background: $surface_alt; }
QPushButton#primary { background: $accent; color: $accent_text; border-color: $accent; font-weight: 600; }
QPushButton#linkButton { border: none; background: transparent; color: $accent; text-align: left; padding: 3px 0; }
QPushButton#linkButton:hover { text-decoration: underline; }

QStatusBar { background: $surface_alt; border-top: 1px solid $border; color: $text_muted; }
QStatusBar QLabel { color: $text_muted; padding: 0 8px; }
QStatusBar::item { border: none; }

QFrame#card { background: $surface; border: 1px solid $border; border-radius: 8px; padding: 12px; }
QFrame#dropZone { background: $surface; border: 2px dashed $border; border-radius: 12px; }
QFrame#dropZone[dragActive="true"] { border-color: $accent; background: $selection; }
QLabel#h1 { font-size: 16pt; font-weight: 600; }
QLabel#muted { color: $text_muted; }
QLabel#badge { background: $surface_alt; color: $text_muted; border-radius: 9px; padding: 3px 12px; }

QScrollBar:vertical { background: transparent; width: 10px; margin: 0; }
QScrollBar:horizontal { background: transparent; height: 10px; margin: 0; }
QScrollBar::handle { background: $border; border-radius: 4px; min-height: 24px; min-width: 24px; }
QScrollBar::handle:hover { background: $text_muted; }
QScrollBar::add-line, QScrollBar::sub-line { width: 0; height: 0; }
QScrollBar::add-page, QScrollBar::sub-page { background: none; }
QToolTip { background: $surface; color: $text; border: 1px solid $border; padding: 4px 6px; }
